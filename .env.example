# =============================================================================
# UNAR website — environment variables
# -----------------------------------------------------------------------------
# On the live site these are entered in Hostinger:
#   hPanel → your Node.js app → Deployments → Settings and redeploy
#   → Environment Variables (you can "import .env").
# NEVER put real values in this file, in GitHub, in screenshots or in chat.
# For local development copy this file to .env.local (which git ignores) and
# fill it in there.
# =============================================================================

# Your website address, without a trailing slash. e.g. https://www.unarfoods.in
# Use none while you only have a temporary hosting address that keeps changing:
# the site then uses the address it is opened on.
NEXT_PUBLIC_SITE_URL=

# --- Database (MySQL / MariaDB — Hostinger: hPanel → Databases) --------------
# The website creates and updates its own tables; the database can start empty.
# On Hostinger DB_HOST is usually localhost.
DB_HOST=
DB_PORT=3306
# Full names including Hostinger's prefix, e.g. u123456789_unar
DB_NAME=
DB_USER=
# SECRET
DB_PASSWORD=
# (Alternatively one line: DATABASE_URL=mysql://user:password@host:3306/name)

# --- First owner account -------------------------------------------------------
# A long secret phrase (12+ characters). Unlocks /setup once, to create the
# owner account. The page locks itself after that. SECRET
SETUP_KEY=

# --- Razorpay (online payments) ---------------------------------------------
# Razorpay Dashboard → Account & Settings → API Keys. Use rzp_test_… keys
# while testing and rzp_live_… keys only when you are ready for real money.
RAZORPAY_KEY_ID=
# SECRET
RAZORPAY_KEY_SECRET=
# The secret YOU type when creating the webhook in Razorpay. SECRET
RAZORPAY_WEBHOOK_SECRET=

# --- Email — choose ONE option (needed for customer accounts) ---------------
# The "From" address customers see, e.g. UNAR <orders@unarfoods.in>
EMAIL_FROM=
# Option A: your Hostinger email (hPanel → Emails → create orders@your-domain)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# The full mailbox address, e.g. orders@unarfoods.in
SMTP_USER=
# That mailbox's password. SECRET
SMTP_PASSWORD=
# Option B: Resend (resend.com → API Keys). SECRET. Used instead of SMTP when set.
RESEND_API_KEY=

# --- Scheduled payment check -------------------------------------------------
# Any long random text (40+ characters). Protects the daily payment check. SECRET
CRON_SECRET=

# --- Shiprocket — optional ---------------------------------------------------
# Create a separate API user in Shiprocket → Settings → API. SECRET
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- Automated tests ONLY (never set these on the live site) -----------------
# RAZORPAY_API_BASE_URL=http://127.0.0.1:4010/v1
