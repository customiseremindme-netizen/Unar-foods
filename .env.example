# =============================================================================
# UNAR website — environment variables
# -----------------------------------------------------------------------------
# On the live site these are entered in Vercel → Project → Settings →
# Environment Variables. NEVER put real values in this file, in GitHub, in
# screenshots or in chat. For local development copy this file to .env.local
# (which git ignores) and fill it in there.
# =============================================================================

# Your website address, without a trailing slash. e.g. https://www.unarfoods.in
NEXT_PUBLIC_SITE_URL=

# --- Supabase (database, logins, image storage) ------------------------------
# Supabase → Project Settings → API Keys (or Data API).
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (starts with sb_publishable_). Safe to be public.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (starts with sb_secret_). SECRET — server only, never share.
SUPABASE_SECRET_KEY=

# --- Razorpay (online payments) ---------------------------------------------
# Razorpay Dashboard → Account & Settings → API Keys. Use rzp_test_… keys
# while testing and rzp_live_… keys only when you are ready for real money.
RAZORPAY_KEY_ID=
# SECRET
RAZORPAY_KEY_SECRET=
# The secret YOU type when creating the webhook in Razorpay. SECRET
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend) — optional but recommended ------------------------------
# resend.com → API Keys. SECRET
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. UNAR <orders@unarfoods.in>
EMAIL_FROM=

# --- Scheduled payment check -------------------------------------------------
# Any long random text (40+ characters). Vercel sends it to the cron job. SECRET
CRON_SECRET=

# --- Shiprocket — optional ---------------------------------------------------
# Create a separate API user in Shiprocket → Settings → API. SECRET
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- Automated tests ONLY (never set these on Vercel) ------------------------
# RAZORPAY_API_BASE_URL=http://127.0.0.1:4010/v1
