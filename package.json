{
  "name": "unar-foods",
  "version": "1.0.0",
  "private": true,
  "description": "UNAR — One Healthy Habit a Day. Premium e-commerce storefront and admin dashboard.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:db": "VITEST_INTEGRATION=1 vitest run",
    "db:types": "node --no-warnings scripts/generate-db-types.mts"
  },
  "dependencies": {
    "@supabase/postgrest-js": "2.117.3",
    "clsx": "2.1.1",
    "lucide-react": "1.53.0",
    "motion": "14.0.0",
    "mysql2": "3.24.4",
    "next": "16.4.0",
    "nodemailer": "10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
